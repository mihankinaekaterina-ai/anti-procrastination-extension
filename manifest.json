{
  "manifest_version": 3,
  "name": "Таймер прокрастинации",
  "version": "1.0.0",
  "description": "Сначала небольшое полезное задание — затем доступ к сайтам для отдыха.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*",
    "*://*.twitch.tv/*",
    "*://*.vk.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Таймер прокрастинации",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
